{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "PIM.Api/PIM.Api.csproj"
          ],
          "src": "api"
        }
      ],
      "dest": "api-docs",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net8.0"
      }
    },
    {
      "src": [
        {
          "files": [
            "PIM.Web.csproj"
          ],
          "src": "web/PIM.Web"
        }
      ],
      "dest": "web-docs",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api-docs/*.yml",
          "api-docs/index.md"
        ]
      },
      {
        "files": [
          "web-docs/*.yml",
          "web-docs/index.md"
        ]
      },
      {
        "files": [
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/*.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appTitle": "Sistema TechSolve - Documentação Técnica",
      "_appName": "Sistema TechSolve",
      "_appFooter": "Sistema desenvolvido para UNIP - PIM IV",
      "_enableSearch": true
    }
  }
}
