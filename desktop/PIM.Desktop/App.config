<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- URL da API TechSolve -->
        <!-- A API roda na própria máquina, em HTTP simples (sem HTTPS). Sem barra no final e sem "/api" -->
        <!-- Se a API estiver em outro computador da rede, troque localhost pelo IP dele -->
        <add key="ApiBaseUrl" value="http://localhost:5080" />

        <!-- Timeout para requisições HTTP (em segundos) -->
        <add key="RequestTimeout" value="30" />
    </appSettings>
</configuration>