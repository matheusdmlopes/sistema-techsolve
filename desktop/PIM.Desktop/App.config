<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <appSettings>
        <!-- URL da API TechSolve -->
        <!-- Para desenvolvimento local: https://localhost:7095 -->
        <!-- Para produção: https://api-pimads-fghxhgerbkbqhsdx.brazilsouth-01.azurewebsites.net -->
        <add key="ApiBaseUrl" value="https://api-pimads-fghxhgerbkbqhsdx.brazilsouth-01.azurewebsites.net" />

        <!-- Timeout para requisições HTTP (em segundos) -->
        <add key="RequestTimeout" value="30" />
    </appSettings>
</configuration>