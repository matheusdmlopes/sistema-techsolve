@using PIM.Web.Models
@{
    ViewData["Title"] = "Dashboard";
    var metricas = ViewData["Metricas"] as DashboardMetricasDto;
    var chamadosRecentes = ViewData["ChamadosRecentes"] as List<ChamadoDto>;
    var perfilAcessoId = ViewData["PerfilAcessoId"] as int?;
    var isSolicitante = perfilAcessoId == 3;
}

<div class="row mb-4">
    <div class="col-12">
        <h2>Bem-vindo ao Sistema TechSolve, @ViewData["UsuarioNome"]!</h2>
        <p class="text-muted">
            @if (isSolicitante)
            {
                <span>Área do Solicitante - Acompanhe seus chamados</span>
            }
            else
            {
                <span>Central de Atendimento Acadêmico - UNIP</span>
            }
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">@(isSolicitante ? "Meus Chamados Abertos" : "Chamados Abertos")</h5>
                <h2 class="display-4">@(metricas?.ChamadosAbertos ?? 0)</h2>
                <p class="card-text">Aguardando atendimento</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Em Atendimento</h5>
                <h2 class="display-4">@(metricas?.ChamadosEmAndamento ?? 0)</h2>
                <p class="card-text">@(isSolicitante ? "Seus chamados em análise" : "Sendo resolvidos")</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">@(isSolicitante ? "Meus Resolvidos" : "Resolvidos")</h5>
                <h2 class="display-4">@(metricas?.ChamadosResolvidos ?? 0)</h2>
                <p class="card-text">@(isSolicitante ? "Aguardando seu feedback" : "Aguardando feedback")</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Total</h5>
                <h2 class="display-4">@(metricas?.TotalChamados ?? 0)</h2>
                <p class="card-text">@(isSolicitante ? "Todos os seus chamados" : "Todos os chamados")</p>
            </div>
        </div>
    </div>
</div>


<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@(isSolicitante ? "Meus Chamados Recentes" : "Chamados Recentes")</h5>
                <a asp-controller="Chamados" asp-action="Index" class="btn btn-sm btn-primary">
                    @(isSolicitante ? "Ver Meus Chamados" : "Ver Todos")
                </a>
            </div>
            <div class="card-body">
                @if (chamadosRecentes != null && chamadosRecentes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Título</th>
                                    <th>Status</th>
                                    <th>Prioridade</th>
                                    <th>Data</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var chamado in chamadosRecentes)
                                {
                                    <tr>
                                        <td><strong>#@chamado.IdChamado</strong></td>
                                        <td>@chamado.Titulo</td>
                                        <td>
                                            @{
                                                var statusBadge = chamado.Status.Nome.ToLower() switch
                                                {
                                                    "aberto" => "bg-primary",
                                                    "em atendimento" => "bg-warning text-dark",
                                                    "resolvido" => "bg-success",
                                                    "fechado" => "bg-dark",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @statusBadge">@chamado.Status.Nome</span>
                                        </td>
                                        <td>
                                            @{
                                                var prioridadeBadge = chamado.Prioridade.Nivel.ToLower() switch
                                                {
                                                    "baixa" => "bg-success",
                                                    "média" => "bg-warning",
                                                    "alta" => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @prioridadeBadge">@chamado.Prioridade.Nivel</span>
                                        </td>
                                        <td>@chamado.DataAbertura.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <a asp-controller="Chamados" asp-action="Detalhes" asp-route-id="@chamado.IdChamado" class="btn btn-sm btn-outline-primary">
                                                Ver
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">Nenhum chamado encontrado.</p>
                }
            </div>
        </div>
    </div>
</div>
