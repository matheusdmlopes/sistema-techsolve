@model PIM.Web.Models.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="row mb-3">
    <div class="col-md-12">
        <h2><i class="bi bi-pencil"></i> Editar Usuário</h2>
        <p class="text-muted">Atualizar dados do usuário</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Dados do Usuário</h5>
            </div>
            <div class="card-body">
                <form asp-action="Editar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdUsuario" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label">Nome Completo *</label>
                        <input asp-for="NomeCompleto" class="form-control" />
                        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@Model.Email" disabled />
                        <small class="form-text text-muted">O email não pode ser alterado</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefone" class="form-label">Telefone</label>
                        <input asp-for="Telefone" type="tel" class="form-control" placeholder="(11) 99999-9999" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="IdSetor" class="form-label">Setor *</label>
                            <select asp-for="IdSetor" class="form-select">
                                @foreach (var setor in Model.Setores)
                                {
                                    <option value="@setor.IdSetor" selected="@(Model.IdSetor == setor.IdSetor)">
                                        @setor.Nome
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="IdSetor" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="IdPerfil" class="form-label">Perfil de Acesso *</label>
                            <select asp-for="IdPerfil" class="form-select">
                                @foreach (var perfil in Model.Perfis)
                                {
                                    <option value="@perfil.IdPerfil" selected="@(Model.IdPerfil == perfil.IdPerfil)">
                                        @perfil.Nome
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="IdPerfil" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <div>
                            @if (Model.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inativo</span>
                            }
                        </div>
                        <small class="form-text text-muted">Use os botões Ativar/Desativar na listagem para alterar o status</small>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Atenção</h6>
            </div>
            <div class="card-body">
                <p class="small mb-2">
                    <strong>Campos não editáveis:</strong>
                </p>
                <ul class="small">
                    <li><strong>Email:</strong> Não pode ser alterado (é o login)</li>
                    <li><strong>Status (Ativo/Inativo):</strong> Use os botões na listagem</li>
                    <li><strong>Senha:</strong> Use o botão "Resetar Senha" na listagem</li>
                </ul>

                <hr />

                <p class="small mb-2">
                    <strong>O que pode ser alterado:</strong>
                </p>
                <ul class="small mb-0">
                    <li>Nome completo</li>
                    <li>Telefone</li>
                    <li>Setor</li>
                    <li>Perfil de acesso</li>
                </ul>
            </div>
        </div>

        <div class="card border-info mt-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Sobre Perfis</h6>
            </div>
            <div class="card-body">
                <ul class="small mb-0">
                    <li><strong>Administrador:</strong> Acesso completo</li>
                    <li><strong>Técnico:</strong> Atende chamados</li>
                    <li><strong>Usuário:</strong> Solicitante básico</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
