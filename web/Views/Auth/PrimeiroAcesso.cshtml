@model PIM.Web.Models.PrimeiroAcessoViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Primeiro Acesso - Sistema TechSolve</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .primeiro-acesso-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            padding: 40px;
            max-width: 500px;
            width: 100%;
        }
        .header-icon {
            text-align: center;
            margin-bottom: 20px;
        }
        .header-icon i {
            font-size: 60px;
            color: #667eea;
        }
        .alert-info-custom {
            background-color: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 15px;
            margin-bottom: 20px;
        }
        .btn-trocar-senha {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 12px;
            font-weight: bold;
        }
        .btn-trocar-senha:hover {
            opacity: 0.9;
            color: white;
        }
        .password-requirements {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="primeiro-acesso-card">
        <div class="header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="#667eea" class="bi bi-shield-lock" viewBox="0 0 16 16">
                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415z"/>
            </svg>
        </div>

        <div class="text-center mb-4">
            <h3 class="text-primary">Primeiro Acesso</h3>
            <p class="text-muted">Bem-vindo(a), <strong>@Model.NomeUsuario</strong>!</p>
        </div>

        @if (TempData["MensagemPrimeiroAcesso"] != null)
        {
            <div class="alert-info-custom">
                <strong><i class="bi bi-info-circle"></i> Atenção!</strong>
                <p class="mb-0">@TempData["MensagemPrimeiroAcesso"]</p>
            </div>
        }

        <div class="alert alert-warning">
            <strong>Segurança:</strong> Por questões de segurança, você precisa alterar sua senha no primeiro acesso.
        </div>

        <form asp-action="PrimeiroAcesso" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <input type="text" class="form-control" value="@Model.Email" readonly disabled />
            </div>

            <div class="mb-3">
                <label asp-for="SenhaAtual" class="form-label">
                    Senha Atual <span class="text-danger">*</span>
                </label>
                <input asp-for="SenhaAtual" class="form-control" placeholder="Digite sua senha atual" />
                <span asp-validation-for="SenhaAtual" class="text-danger"></span>
                <small class="form-text text-muted">A senha fornecida pelo administrador</small>
            </div>

            <div class="mb-3">
                <label asp-for="NovaSenha" class="form-label">
                    Nova Senha <span class="text-danger">*</span>
                </label>
                <input asp-for="NovaSenha" class="form-control" placeholder="Digite sua nova senha" />
                <span asp-validation-for="NovaSenha" class="text-danger"></span>
                <div class="password-requirements">
                    <i class="bi bi-check-circle"></i> Mínimo 6 caracteres<br />
                    <i class="bi bi-check-circle"></i> Use uma senha forte e única
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarNovaSenha" class="form-label">
                    Confirmar Nova Senha <span class="text-danger">*</span>
                </label>
                <input asp-for="ConfirmarNovaSenha" class="form-control" placeholder="Confirme sua nova senha" />
                <span asp-validation-for="ConfirmarNovaSenha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-trocar-senha w-100 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle me-2" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                </svg>
                Alterar Senha e Continuar
            </button>
        </form>

        <div class="text-center mt-4">
            <small class="text-muted">
                Após alterar a senha, você será direcionado ao sistema.
            </small>
        </div>

        <div class="text-center mt-3">
            <a asp-action="Logout" class="btn btn-link text-muted">Sair do Sistema</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
