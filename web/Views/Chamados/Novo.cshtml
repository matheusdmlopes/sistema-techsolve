@model PIM.Web.Models.NovoChamadoViewModel
@{
    ViewData["Title"] = "Novo Chamado";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Abrir Novo Chamado</h4>
            </div>
            <div class="card-body">
                <form asp-action="Novo" asp-controller="Chamados" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">
                            Título do Chamado <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Titulo" class="form-control" placeholder="Resumo breve do problema" maxlength="100" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label">
                            Descrição Detalhada <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Descricao" class="form-control" rows="6"
                                  placeholder="Descreva o problema com o máximo de detalhes possível..."
                                  maxlength="2000"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                        <small class="form-text text-muted">
                            Mínimo 10 caracteres. Quanto mais detalhes, melhor!
                        </small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="IdCategoria" class="form-label">
                                Categoria <span class="text-danger">*</span>
                            </label>
                            <select asp-for="IdCategoria" class="form-select">
                                <option value="">Selecione uma categoria</option>
                                @foreach (var categoria in Model.Categorias)
                                {
                                    <option value="@categoria.IdCategoria">@categoria.Nome</option>
                                }
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="IdPrioridade" class="form-label">
                                Prioridade <span class="text-danger">*</span>
                            </label>
                            <select asp-for="IdPrioridade" class="form-select">
                                <option value="">Selecione a prioridade</option>
                                @foreach (var prioridade in Model.Prioridades)
                                {
                                    <option value="@prioridade.IdPrioridade">@prioridade.Nivel</option>
                                }
                            </select>
                            <span asp-validation-for="IdPrioridade" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <strong>Dica:</strong> Seja o mais específico possível na descrição do problema.
                        Isso ajudará nossa equipe técnica a resolver seu chamado mais rapidamente.
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> Abrir Chamado
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
