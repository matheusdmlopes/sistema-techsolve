@model int
@inject IConfiguration Configuration
@{
    var idChamado = Model;
    var usuarioId = ViewContext.HttpContext.Session.GetInt32("UsuarioId");
    var usuarioNome = ViewContext.HttpContext.Session.GetString("UsuarioNome");
    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"];
}

<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">
            <i class="bi bi-chat-dots"></i> Chat do Chamado
            <span class="badge bg-light text-dark ms-2" id="badge-online-@idChamado">
                <i class="bi bi-circle-fill text-success" style="font-size: 0.5rem;"></i> Online
            </span>
        </h5>
    </div>
    <div class="card-body p-0">
        <!-- Container de Mensagens -->
        <div id="chat-mensagens-@idChamado" class="chat-container">
            <!-- Mensagens serão inseridas aqui via JavaScript -->
            <div class="text-center text-muted">
                <i class="bi bi-chat-left-dots"></i>
                <p class="small">Carregando mensagens...</p>
            </div>
        </div>

        <!-- Indicador de digitação -->
        <div id="indicador-digitando-@idChamado" class="chat-typing-indicator">
            <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <span>Alguém está digitando...</span>
        </div>

        <!-- Input de Mensagem -->
        <div class="chat-input-area">
            <div class="chat-input-wrapper">
                <textarea
                    id="input-mensagem-@idChamado"
                    class="chat-input"
                    placeholder="Digite sua mensagem..."
                    maxlength="2000"></textarea>
                <button
                    id="btn-enviar-mensagem-@idChamado"
                    class="btn btn-primary chat-btn-enviar"
                    type="button">
                    <i class="bi bi-send-fill"></i> Enviar
                </button>
            </div>
            <small class="text-muted d-block mt-2">Pressione Enter para enviar ou Shift+Enter para quebrar linha</small>
        </div>
    </div>
</div>

<script src="~/js/chat-chamado.js"></script>
<script>
    // Inicializar chat quando a página carregar
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            inicializarChat(@idChamado, @usuarioId, '@usuarioNome', '@apiBaseUrl');
        });
    } else {
        // DOM já carregado
        inicializarChat(@idChamado, @usuarioId, '@usuarioNome', '@apiBaseUrl');
    }
</script>
