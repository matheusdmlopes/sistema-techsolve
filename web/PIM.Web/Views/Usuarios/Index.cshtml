@model List<PIM.Web.Models.UsuarioListaDto>
@{
    ViewData["Title"] = "Gerenciar Usuários";
    var perfis = ViewData["Perfis"] as List<PIM.Web.Models.PerfilAcessoDto> ?? new();
    var setores = ViewData["Setores"] as List<PIM.Web.Models.SetorDto> ?? new();
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2><i class="bi bi-people"></i> Gerenciar Usuários</h2>
        <p class="text-muted">Administração de usuários do sistema</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Criar" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Novo Usuário
        </a>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" id="formFiltros">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Perfil</label>
                    <select name="perfil" class="form-select form-select-sm" onchange="document.getElementById('formFiltros').submit()">
                        <option value="">Todos</option>
                        @foreach (var p in perfis)
                        {
                            <option value="@p.IdPerfil" selected="@(ViewData["FiltroPerfil"]?.ToString() == p.IdPerfil.ToString())">
                                @p.Nome
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Setor</label>
                    <select name="setor" class="form-select form-select-sm" onchange="document.getElementById('formFiltros').submit()">
                        <option value="">Todos</option>
                        @foreach (var s in setores)
                        {
                            <option value="@s.IdSetor" selected="@(ViewData["FiltroSetor"]?.ToString() == s.IdSetor.ToString())">
                                @s.Nome
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Buscar por nome ou email</label>
                    <input type="text" name="busca" class="form-control form-control-sm"
                           placeholder="Digite para buscar..."
                           value="@ViewData["FiltroBusca"]">
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Limpar Filtros
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Tabela de Usuários -->
@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Nenhum usuário encontrado.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Setor</th>
                            <th>Perfil</th>
                            <th>Status</th>
                            <th>Último Login</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@usuario.NomeCompleto</strong>
                                    @if (usuario.PrimeiroAcesso)
                                    {
                                        <br /><small class="text-warning"><i class="bi bi-exclamation-circle"></i> Primeiro acesso pendente</small>
                                    }
                                </td>
                                <td>@usuario.Email</td>
                                <td>@usuario.Setor.Nome</td>
                                <td>
                                    @{
                                        var perfilBadge = usuario.Perfil.Nome switch
                                        {
                                            "Administrador" => "bg-danger",
                                            "Técnico" => "bg-primary",
                                            "Usuário" => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @perfilBadge">@usuario.Perfil.Nome</span>
                                </td>
                                <td>
                                    @if (usuario.Ativo)
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inativo</span>
                                    }
                                </td>
                                <td>
                                    @if (usuario.UltimoLogin.HasValue)
                                    {
                                        @usuario.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nunca</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (usuario.Ativo)
                                        {
                                            <form asp-action="ToggleAtivo" asp-route-id="@usuario.Id" asp-route-ativo="false" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Desativar"
                                                        onclick="return confirm('Deseja realmente desativar este usuário?')">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleAtivo" asp-route-id="@usuario.Id" asp-route-ativo="true" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Ativar">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="ResetarSenha" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="Resetar Senha"
                                                    onclick="return confirm('Resetar senha para \'senha123\'?')">
                                                <i class="bi bi-key"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <p class="text-muted">Total: <strong>@Model.Count</strong> usuário(s)</p>
    </div>
}
