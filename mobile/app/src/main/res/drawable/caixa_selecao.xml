<?xml version="1.0" encoding="utf-8"?>
<!-- Caixa das listas de escolha: borda fina e seta à direita, no lugar do botão cinza antigo do Android -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="#FF9CA3AF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_seta_baixo"
        android:end="12dp"
        android:gravity="end|center_vertical" />
</layer-list>
